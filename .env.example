# Copy this file as .env and replace the example values.
# Never commit the real .env file.

# `python scripts/download_data.py` writes the real local value to .env.
# Directory containing the extracted chest_xray folder:
XRAY_DATA_ROOT=/path/to/chest_xray

# Local or shared directory for experiment outputs
XRAY_OUTPUT_ROOT=outputs

# DataLoader worker count; adjust for the machine
XRAY_NUM_WORKERS=4
